# Local dev secrets for `supabase functions serve --env-file supabase/functions/.env`.
# In deployed (staging/production) environments, set these instead with:
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=...
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the platform -- do not set them here or in `supabase secrets`.
#
# Get RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET from the Razorpay Dashboard >
# Settings > API Keys (use Test Mode keys until you're ready to go live).
# RAZORPAY_WEBHOOK_SECRET is whatever secret you set when creating the
# webhook in the Razorpay Dashboard (Settings > Webhooks), pointed at:
#   https://<your-project-ref>.supabase.co/functions/v1/razorpay-webhook

RAZORPAY_KEY_ID=rzp_live_TMt44MHg9Gjk1g
RAZORPAY_KEY_SECRET=C1cEzmpbfhwaY7p1NXM1veSl
RAZORPAY_WEBHOOK_SECRET=https://express.razorpay.com/wix/v1/webhook-handler

# Your deployed frontend origin, e.g. https://craftoria.com -- locks down
# CORS on create-razorpay-order/verify-razorpay-payment/process-razorpay-refund
# to this origin. Leave unset for local dev (falls back to allowing any origin).
APP_URL=
