# Craftoria Environment Variables Template
# Both frontend-safe (VITE_-prefixed, bundled into the browser build --
# these are the public anon key, never the service-role key). No backend
# secrets belong in this file; see supabase/functions/.env.example for the
# server-only Edge Function secrets (Razorpay keys, webhook secret).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Accepted as a fallback if VITE_SUPABASE_PUBLISHABLE_KEY isn't set (see
# src/lib/supabase.js) -- only one of the two is required.
VITE_SUPABASE_ANON_KEY=
