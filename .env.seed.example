# Server-only credentials for one-off scripts (scripts/seed-catalog.mjs).
# NEVER prefix these with VITE_ -- that would bundle them into the browser
# build. Get the service role key from Supabase Dashboard > Project Settings
# > API > service_role secret. Never commit the real values.
#
# Usage: node --env-file=.env.seed scripts/seed-catalog.mjs

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
